# =====================================================================
#  Lahlal — gestion de flotte : variables d'environnement
# =====================================================================
#
#  Copiez ce fichier en « .env », puis :
#
#     npm run keygen -- --write     genere les secrets
#     npm run check                 verifie la configuration
#     npm run migrate && npm run seed
#
#  CE QUI SE REGLE ICI, ET CE QUI NE S'Y REGLE PAS
#  -----------------------------------------------
#  Ce fichier porte l'infrastructure : port, base, secrets, bornes de
#  securite. Il ne porte AUCUN seuil metier. Les seuils d'alerte des
#  echeances — a partir de combien de kilometres une vidange devient
#  « urgente » — se reglent dans l'application, ecran Parametres, et vivent
#  en base. Les y chercher ici serait perdre son temps.

# ---------------------------------------------------------------------
#  Reseau
# ---------------------------------------------------------------------
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# LE FUSEAU HORAIRE. Il n'est pas decoratif.
#
# Toutes les dates de cette application sont des dates CALENDAIRES : le jour
# d'une activite, l'echeance d'une assurance. Sans TZ, le conteneur tourne
# en UTC — et au Maroc (UTC+1), entre minuit et une heure du matin, il est
# deja demain localement et encore aujourd'hui en UTC. L'activite qu'on
# vient de finir est alors refusee comme etant « dans le futur ».
#
# Posez-le meme si la machine est deja reglee : un conteneur n'herite pas du
# fuseau de son hote.
TZ=Africa/Casablanca

# L'application est-elle derriere un proxy (Caddy, Traefik, nginx) ?
TRUST_PROXY=true
# Nombre EXACT de proxys devant l'application. Un compte trop eleve laisse
# le client choisir l'adresse IP que voit la limitation de debit.
TRUST_PROXY_HOPS=1
# N'activez X-Real-IP que si votre proxy ECRASE cet en-tete. Sinon un client
# qui le fabrique se presente sous une adresse neuve a chaque appel et
# echappe a toute limitation.
TRUST_REAL_IP=false

# Origines autorisees pour les requetes mutantes (protection CSRF).
# Plusieurs valeurs separees par des virgules, sans barre oblique finale.
ALLOWED_ORIGINS=https://flotte.example.com

# ---------------------------------------------------------------------
#  Base de donnees
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://utilisateur:MOT_DE_PASSE@hote:5432/flotte
# off | require | verify   (« verify » impose DATABASE_CA_CERT)
DATABASE_SSL=require
# DATABASE_CA_CERT=
DATABASE_POOL_MAX=8
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=12000
DATABASE_IDLE_TIMEOUT_MS=600000

# ---------------------------------------------------------------------
#  Secrets — 64 caracteres hexadecimaux chacun, et DISTINCTS
#  Generez-les avec : npm run keygen
#  Ne les versionnez jamais.
# ---------------------------------------------------------------------
APP_SECRET=
APP_PASSWORD_PEPPER=

# ---------------------------------------------------------------------
#  Securite
# ---------------------------------------------------------------------
SECURE_COOKIES=true
ENABLE_HSTS=true
# Ces six valeurs sont le POINT DE DEPART : une fois l'application en
# service, elles se reglent a l'ecran (Parametres > Securite) et la valeur
# de la base l'emporte.
SESSION_IDLE_MINUTES=45
SESSION_ABSOLUTE_HOURS=12
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------
#  Pieces jointes
# ---------------------------------------------------------------------
# Taille maximale d'un fichier, en megaoctets (entre 1 et 50).
# Une photo de compteur prise au telephone pese couramment 3 a 5 Mo ; le
# navigateur la reduit avant l'envoi.
UPLOAD_MAX_MB=10

# Dossier de travail (ancre du journal d'audit). Les pieces jointes, elles,
# sont stockees en base : un conteneur qui redemarre ne doit rien perdre.
DATA_DIR=./data

# ---------------------------------------------------------------------
#  Journal d'audit
# ---------------------------------------------------------------------
# L'ancre externe : a chaque entree validee, la tete de chaine s'ecrit dans
# un fichier de DATA_DIR. La chaine de condensats detecte une entree
# modifiee ; l'ancre detecte une queue coupee par quelqu'un qui tient la
# base. Ce dossier doit donc etre PERSISTANT — sur un systeme de fichiers
# ephemere, l'ancre disparait a chaque redemarrage et ne prouve plus rien.
AUDIT_ANCRE_EXTERNE=true

# ---------------------------------------------------------------------
#  Premier compte
# ---------------------------------------------------------------------
# Cree au premier « npm run seed », et seulement si la base n'a aucun compte.
# Le mot de passe doit etre change a la premiere connexion.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
